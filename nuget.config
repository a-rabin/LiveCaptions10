<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep restored packages inside the repo folder (no per-user cache on the system drive). -->
    <add key="globalPackagesFolder" value=".tools\nuget\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
