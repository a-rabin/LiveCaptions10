<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LiveCaptions10</AssemblyName>
    <RootNamespace>LiveCaptions10</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>a-rabin</Authors>
    <Description>Offline live captions for Windows 10: captions whatever your PC is playing.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>Live Captions for Windows 10</Product>
    <!-- WPF needs the Per-Monitor V2 manifest entry; WinForms (tray/menus) would rather use an API call. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="2.0.1" />
  </ItemGroup>

  <!-- Only the win-x64 native libraries are used; drop the other platforms' copies (~60 MB). -->
  <Target Name="RemoveForeignNativeLibs" AfterTargets="Publish">
    <ItemGroup>
      <_ForeignRuntimeDirs Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)runtimes', '*', System.IO.SearchOption.AllDirectories))"
                           Condition="Exists('$(PublishDir)runtimes')" />
      <_ForeignRuntimeDirs Remove="@(_ForeignRuntimeDirs)" Condition="'%(Filename)%(Extension)' == 'win-x64' Or '%(Filename)%(Extension)' == 'vulkan'" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignRuntimeDirs)" />
  </Target>

</Project>
